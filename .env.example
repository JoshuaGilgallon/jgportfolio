# Admin sign-in. Generate a hash with: npm run hash-password
ADMIN_USERNAME=josh
ADMIN_PASSWORD_HASH=

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Local SQLite file by default; use a libsql:// URL (e.g. Turso) in production.
DATABASE_URL=file:./data/portfolio.db
DATABASE_AUTH_TOKEN=

# Public URL, used for canonical links, the sitemap and RSS.
SITE_URL=http://localhost:3000
