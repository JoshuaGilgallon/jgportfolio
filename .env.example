# generate the hash with: npm run hash-password
ADMIN_USERNAME=josh
ADMIN_PASSWORD_HASH=

# generate with: openssl rand -base64 32
AUTH_SECRET=

# use a libsql:// url in production
DATABASE_URL=file:./data/portfolio.db
DATABASE_AUTH_TOKEN=

# used for canonical links, sitemap and rss
SITE_URL=http://localhost:3000
