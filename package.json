{
  "name": "jgportfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "dev": "next dev",
    "prebuild": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@shikijs/rehype": "^4.6.0",
    "drizzle-orm": "^0.45.4",
